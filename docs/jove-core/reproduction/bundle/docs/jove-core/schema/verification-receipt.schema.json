{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai2human.example/schemas/verification-receipt.schema.json",
  "title": "Verification Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "decision_id", "contract_id", "contract_version", "task_id", "evidence_commitments", "obligation_results", "verifier_state", "decision", "transition", "created_at"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_version": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "minLength": 1},
    "evidence_commitments": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "obligation_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["obligation_id", "state", "reason_codes"],
        "properties": {
          "obligation_id": {"type": "string", "minLength": 1},
          "state": {"enum": ["true", "false", "unknown"]},
          "reason_codes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "verifier_state": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_versions", "threshold_version", "degraded"],
      "properties": {
        "provider_versions": {"type": "array", "items": {"type": "string"}},
        "threshold_version": {"type": "string", "minLength": 1},
        "degraded": {"type": "boolean"}
      }
    },
    "decision": {"enum": ["accept", "reject", "abstain"]},
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "eligible", "decision_id"],
      "properties": {"action": {"type": "string", "minLength": 1}, "eligible": {"type": "boolean"}, "decision_id": {"type": "string", "minLength": 1}}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "appeal_of": {"type": ["string", "null"]}
  }
}
